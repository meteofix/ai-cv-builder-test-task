# Required. Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Uncomment to change; the values shown are the defaults.
# WEB_PORT=8080
# The host port Compose publishes Postgres on. The tests and a locally started API read DB_PORT instead:
# when you change this, set DB_PORT to the same number.
# POSTGRES_PORT=5432
# DB_PORT=5432
# Set to true when the app is served over HTTPS (marks the session cookie Secure).
# COOKIE_SECURE=false
# GENERATIONS_PER_USER_PER_DAY=30
# GENERATIONS_TOTAL=300
# The two model calls of a generation (decision 035); effort is low | medium | high | xhigh | max.
# AUTHOR_MODEL=claude-opus-5-5
# AUTHOR_EFFORT=medium
# REVIEWER_MODEL=claude-opus-5-5
# REVIEWER_EFFORT=low
# LOG_LEVEL=info
# A model call times out after this long; a job makes at most LLM_CALL_BUDGET calls, re-asks included.
# LLM_TIMEOUT_MS=300000
# LLM_CALL_BUDGET=15
# SESSION_TTL_DAYS=30
# AUTH_RATE_LIMIT_PER_MINUTE=10
# The API's PDF limit (10 MiB). The web container's nginx refuses bodies over 11m and the browser checks 10 MB,
# so raising it needs those two changed as well.
# MAX_UPLOAD_BYTES=10485760
