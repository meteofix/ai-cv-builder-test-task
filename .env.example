# Required. Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Uncomment to change; the values shown are the defaults.
# WEB_PORT=8080
# POSTGRES_PORT=5432
# Set to true when the app is served over HTTPS (marks the session cookie Secure).
# COOKIE_SECURE=false
# GENERATIONS_PER_USER_PER_DAY=30
# GENERATIONS_TOTAL=300
# The two model calls of a generation (decision 035); effort is low | medium | high | xhigh | max.
# AUTHOR_MODEL=claude-opus-5-5
# AUTHOR_EFFORT=medium
# REVIEWER_MODEL=claude-opus-5-5
# REVIEWER_EFFORT=low
# LOG_LEVEL=info
